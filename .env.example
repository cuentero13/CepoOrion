# Variables de entorno — CEPO
# Copiar a .env.local (nunca subir .env.local a GitHub).
# Ver docs/supabase-setup.md para crear el proyecto y obtener cada valor.

# Supabase (obligatorio para login, progreso y buzón)
NEXT_PUBLIC_SUPABASE_URL=[COMPLETAR: URL del proyecto Supabase]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[COMPLETAR: clave anon / publishable del proyecto]
# Solo servidor. NUNCA exponer en el cliente ni subir a GitHub.
SUPABASE_SERVICE_ROLE_KEY=[COMPLETAR: clave service_role — solo servidor]

# Cloudflare Turnstile — anti-spam del buzón (opcional; si no hay claves,
# el buzón funciona sin captcha y queda documentado en docs/supabase-setup.md)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=[COMPLETAR: site key de Turnstile — opcional]
TURNSTILE_SECRET_KEY=[COMPLETAR: secret key de Turnstile — opcional]
